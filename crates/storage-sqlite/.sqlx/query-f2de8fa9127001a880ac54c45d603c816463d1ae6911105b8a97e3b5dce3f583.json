  "query": "SELECT p.id, p.log_entry_id, p.value_ugm3, ph.object_key AS \"object_key?\", ph.bytes AS \"bytes?\", ph.sha256 AS \"sha256?\", ph.taken_at AS \"taken_at?\" FROM pm25_readings p LEFT JOIN pm25_photos ph ON ph.pm25_reading_id = p.id JOIN log_entries e ON e.id = p.log_entry_id WHERE e.deleted_at IS NULL AND e.observed_at >= $1 AND e.observed_at < $2",
