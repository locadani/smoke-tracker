  "query": "SELECT l.smell_report_id, l.symptom_id FROM smell_report_symptoms l JOIN smell_reports r ON r.id = l.smell_report_id JOIN log_entries e ON e.id = r.log_entry_id WHERE e.deleted_at IS NULL AND e.observed_at >= $1 AND e.observed_at < $2 ORDER BY l.smell_report_id, l.symptom_id",
