  "query": "SELECT l.smell_report_id, l.room_id, l.level FROM smell_report_rooms l JOIN smell_reports r ON r.id = l.smell_report_id JOIN log_entries e ON e.id = r.log_entry_id WHERE e.deleted_at IS NULL AND e.event_id = $1 ORDER BY l.smell_report_id, l.room_id",
